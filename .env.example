# Set a long, random alphanumeric value. Alphanumeric values avoid URL encoding
# concerns because Compose also injects this value into Sentinel's database URL.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_CONFIG_DB_PASSWORD=
GRAFANA_REPORTING_DB_PASSWORD=
# Override when the dashboard is accessed through another local host name.
GRAFANA_ROOT_URL=http://localhost:8080/grafana/

# Optional non-secret database names. Leave these defaults unless your
# deployment has a specific naming convention.
# POSTGRES_USER=sentinel
# POSTGRES_DB=sentinel_db
